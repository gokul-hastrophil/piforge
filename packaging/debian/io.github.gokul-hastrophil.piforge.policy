<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>PiForge</vendor>
  <vendor_url>https://github.com/gokul-hastrophil/piforge</vendor_url>
  <icon_name>piforge</icon_name>

  <action id="io.github.gokul-hastrophil.piforge.run-server">
    <description>Run the PiForge SD-card flashing server</description>
    <message>Authentication is required to flash SD cards — PiForge needs root to write raw disk devices</message>
    <icon_name>piforge</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/piforge/piforge-server-root</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
